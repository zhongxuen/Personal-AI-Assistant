# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# The IANA timezone the assistant answers wall-clock questions in ("what time is it",
# "remind me tomorrow at 8pm", whether a reminder is due). This is the USER's timezone,
# not the server's: a deployed backend runs in UTC, so leaving this to the host clock
# makes `get_time` report a right date at an hours-wrong time. Set "" to follow the
# host machine's own clock instead (correct for a desktop-only install).
ASSISTANT_TIMEZONE=Asia/Kuala_Lumpur

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins allowed to call the API from the browser
CORS_ORIGINS=http://localhost:5173

# --- Database / local storage ---
# Everything (conversations, memory, attachments) stays on the machine running the
# backend: this SQLite file plus the attachments directory. Nothing syncs to a cloud.
DATABASE_URL=sqlite:///./jarvis.db
# Where chat attachments are written (default backend/data/attachments/, gitignored).
# ATTACHMENTS_DIR=
# ATTACHMENT_MAX_BYTES=10485760     # upload cap; attachments are sent inline per request
# ATTACHMENT_MAX_PER_MESSAGE=5
# Reported by /api/health as storage_mode. Unset -> auto: "ephemeral" when the RENDER
# env var is present (Render's free disk is wiped on restart), else "local-durable".
# STORAGE_EPHEMERAL=

# --- Authentication (§34, file 12 prompt 1) ---
# MUST be overridden before this backend is reachable from anywhere but localhost --
# the shipped default is intentionally insecure (main.py warns at startup if it's
# still active outside APP_ENV=development). See docs/security.md.
# AUTH_SECRET_KEY=change-me-to-a-long-random-value
# AUTH_ALGORITHM=HS256
# AUTH_TOKEN_EXPIRE_MINUTES=1440
# One-time bootstrap user for POST /api/auth/login -- created at startup if unset users
# with this username don't already exist; leave both unset to skip seeding entirely.
# AUTH_SEED_USERNAME=
# AUTH_SEED_PASSWORD=

# --- LLM providers ---
# Chain: OpenAI (1) -> Ollama (2) -> Gemini (3, off by default).
#
# OpenAI is the primary provider. Every request uses the Responses API with store=False
# (enforced in code, not configurable): no stored responses, no previous_response_id,
# no file uploads -- history and attachments are sent inline by us on each request.
# OPENAI_API_KEY=   # required; unset -> OpenAIProvider.is_available() is False
# OPENAI_ENABLED=true
# OPENAI_MODEL=gpt-5.4-mini        # must be a model OPENAI_API_KEY can use; 404 -> MISCONFIGURED
# OPENAI_TIMEOUT_SECONDS=30
# OPENAI_MAX_RETRIES=1             # RETRYABLE_ERROR only; never after streaming has started
# OPENAI_RETRY_BASE_DELAY_SECONDS=0.4
# OPENAI_REASONING_EFFORT=         # optional: none|minimal|low|medium|high (model-dependent)
#
# OpenAI spend budget, metered in USD from token counts x the prices below. Keep it
# below the hard budget set on the OpenAI project so the app fails over first.
# OPENAI_DAILY_BUDGET_USD=1.00
# OPENAI_MONTHLY_BUDGET_USD=       # optional
# OPENAI_WARNING_THRESHOLD=0.80
# OPENAI_CRITICAL_THRESHOLD=0.90
# Per-million-token prices for OPENAI_MODEL -- placeholders; keep them in sync with
# https://openai.com/api/pricing or the spend bar/budget will be wrong.
# OPENAI_INPUT_PRICE_PER_MTOK=0.75
# OPENAI_CACHED_INPUT_PRICE_PER_MTOK=0.075
# OPENAI_OUTPUT_PRICE_PER_MTOK=4.50
#
# Tool-result loop: max tool rounds per turn before a final text-only call.
# LLM_MAX_TOOL_STEPS=4
#
# Gemini is OFF by default and last in the chain: the free tier lets Google use
# submitted content to improve its products, so it must never be a silent failover.
# Enable only with a paid key, or if that trade-off is acceptable to you.
# GEMINI_ENABLED=false
# GEMINI_API_KEY=  # required for Gemini calls; unset -> GeminiProvider.is_available() is False
# GEMINI_MODEL=gemini-3.6-flash   # must be a model GEMINI_API_KEY can reach; 404 -> MISCONFIGURED
# Defaults are tuned for a person waiting on a chat reply, not for maximum stubbornness:
# together these cap a failing Gemini turn at roughly 30s before the Ollama fallback is
# tried, instead of the ~93s the previous 30s/2-retry/1s-backoff defaults allowed.
# GEMINI_TIMEOUT_SECONDS=15
# GEMINI_MAX_RETRIES=1           # retries for RETRYABLE_ERROR only, never quota/permanent
# GEMINI_RETRY_BASE_DELAY_SECONDS=0.4

# --- AI Router / quota + health (file 06) ---
# Internal request budget, deliberately kept BELOW Gemini's real daily quota -- not
# Google's actual limit (never hardcode that; it can change without notice).
# GEMINI_DAILY_REQUEST_BUDGET=80
# GEMINI_WARNING_THRESHOLD=0.80   # fraction of budget used -> QuotaManager.status() = WARNING
# GEMINI_CRITICAL_THRESHOLD=0.90  # fraction of budget used -> QuotaManager.status() = CRITICAL
# LLM_QUOTA_COOLDOWN_SECONDS=60      # cooldown after a QUOTA_EXHAUSTED result
# LLM_RETRYABLE_ERROR_THRESHOLD=3    # consecutive RETRYABLE_ERRORs before a provider is parked
# LLM_RETRYABLE_COOLDOWN_SECONDS=30
# LLM_PERMANENT_ERROR_THRESHOLD=3    # consecutive PERMANENT_ERRORs before MISCONFIGURED -> DISABLED

# Ollama local fallback (priority 2) -- nothing leaves the machine.
# OLLAMA_ENABLED=true
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# --- Platform adapters ---
# Backend-only, never real values in this file. Each one unset -> that adapter no-ops
# rather than erroring (app/config/settings.py).
# DISCORD_BOT_TOKEN=

# WhatsApp Cloud API (file 18). Setup steps -- Meta app, test number, tokens, webhook --
# are in docs/deployment.md's "WhatsApp Cloud API setup"; these four are what the backend
# actually reads. Any of them unset -> WhatsApp stays off.
# Meta's 24h temporary token for early dev, or a System User token for anything longer.
# WHATSAPP_ACCESS_TOKEN=
# The Cloud API's id for the sending number (numeric), NOT the number itself.
# WHATSAPP_PHONE_NUMBER_ID=
# Self-chosen string; type the same value here and into Meta's webhook config, which
# echoes it back on the GET verification handshake. Treat it as a secret.
# WHATSAPP_VERIFY_TOKEN=
# Meta app secret -- verifies the X-Hub-Signature-256 HMAC on every inbound webhook POST.
# WHATSAPP_APP_SECRET=
# The WABA (WhatsApp Business Account) id is needed in Meta's dashboard and for message
# templates, but nothing in the backend reads it -- kept here only as a place to note it.
# WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- Frontend ---
# VITE_API_BASE_URL=  # leave unset in dev; Vite proxies /api to the backend

# --- Web push (browser notifications) ---
# Generate a pair with `vapid --gen` (py_vapid, installed with pywebpush), or any
# P-256 keygen -- both values base64url-encoded and unpadded. The public half is
# deliberately also exposed to the frontend (PushManager.subscribe's
# applicationServerKey); the private half is backend-only, like DISCORD_BOT_TOKEN.
# Leave both unset to no-op push entirely.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact URI sent as the VAPID `sub` claim so a push service can reach whoever runs
# this backend. Not a secret; defaults to mailto:jarvis@localhost if unset.
# VAPID_SUBJECT=mailto:you@example.com
