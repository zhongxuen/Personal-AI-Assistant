# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins allowed to call the API from the browser
CORS_ORIGINS=http://localhost:5173

# --- Database ---
DATABASE_URL=sqlite:///./jarvis.db

# --- LLM providers (added in Phase 4+, placeholders only for now) ---
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# --- Platform adapters (added in Phase 12+, placeholders only for now) ---
# DISCORD_BOT_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_VERIFY_TOKEN=  # self-chosen string used to verify the webhook callback URL later

# --- Frontend ---
# VITE_API_BASE_URL=  # leave unset in dev; Vite proxies /api to the backend
